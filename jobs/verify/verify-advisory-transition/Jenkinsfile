#!/usr/bin/env groovy

node {
    timestamps {
    checkout scm
    def buildlib = load("pipeline-scripts/buildlib.groovy")
    def commonlib = buildlib.commonlib

    commonlib.describeJob("verify-advisory-transition", """
        Verify metadata URLs and move Errata Tool advisories from QE to REL_PREP.
        Excludes MicroShift and transitions QE advisories only. Elliott then
        verifies all active advisories have progressed beyond QE.
        Requires verify-release-success on the shipment MR and adds
        advisory-transition-success after successful processing.
    """)

    properties([
        disableResume(),
        buildDiscarder(logRotator(daysToKeepStr: '30', numToKeepStr: '100')),
        [
            $class: 'ParametersDefinitionProperty',
            parameterDefinitions: [
                commonlib.ocpVersionParam('BUILD_VERSION', '4plus'),
                commonlib.artToolsParam(),
                commonlib.dryrunParam(),
                commonlib.mockParam(),
                string(
                    name: 'ASSEMBLY',
                    description: 'Assembly whose advisories should move to REL_PREP (e.g. 4.22.9)',
                    defaultValue: "",
                    trim: true,
                ),
            ]
        ],
    ])
    commonlib.checkMock()
    if (!params.ASSEMBLY) {
        error("ASSEMBLY is required")
    }

    try {
        lock(resource: "verify-advisory-transition-${params.BUILD_VERSION}-${params.ASSEMBLY}", skipIfLocked: true) {
            sshagent(["openshift-bot"]) {
                stage("initialize") {
                    currentBuild.displayName = "${params.BUILD_VERSION} - ${params.ASSEMBLY} - #${currentBuild.number}"
                    buildlib.kinit()
                    buildlib.init_artcd_working_dir()
                }
                stage("verify-advisory-transition") {
                    def cmd = [
                        "artcd",
                        "-v",
                        "--working-dir=./artcd_working",
                        "--config=./config/artcd.toml",
                    ]
                    if (params.DRY_RUN) {
                        cmd += ["--dry-run"]
                    }
                    cmd += [
                        "verify-advisory-transition",
                        "--version=${params.BUILD_VERSION}",
                        "--assembly=${params.ASSEMBLY}",
                    ]
                    withCredentials([
                        string(credentialsId: 'art-bot-jenkins-gitlab', variable: 'GITLAB_TOKEN'),
                    ]) {
                        echo "Will run: ${cmd.join(' ')}"
                        sh(script: cmd.join(' '))
                    }
                }
            }
        }
    } finally {
        commonlib.safeArchiveArtifacts([
            "artcd_working/**/*.log",
            "artcd_working/**/*.yaml",
            "artcd_working/**/*.yml",
            "artcd_working/**/*.json",
        ])
        buildlib.cleanWorkspace()
    }
    }
}
